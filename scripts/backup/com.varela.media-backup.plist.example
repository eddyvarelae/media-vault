<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Attached-SSD gap report, report-only (B22): every five minutes, if a
     known source SSD is mounted and not yet reported since it was attached
     (or today), run `vault gap` on it and log what still needs archiving.
     Copies nothing. Install like the video-tagger agent: copy to
     ~/Library/LaunchAgents/com.varela.media-backup.plist (drop the .example),
     then launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.varela.media-backup.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.varela.media-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/varela/Projects/media-vault/scripts/backup/run-backup.sh</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>/Users/varela/Library/Logs/mini-server/media-backup.log</string>
  <key>StandardErrorPath</key><string>/Users/varela/Library/Logs/mini-server/media-backup.log</string>
</dict>
</plist>
